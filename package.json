{
  "name": "dusaccom",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/optimize-images.mjs && next build --webpack",
    "build:firebase": "node scripts/optimize-images.mjs && node scripts/build-firebase.mjs",
    "deploy:firebase": "npm run build:firebase && node scripts/deploy-firebase.mjs",
    "deploy:hosting-only": "npm run build:firebase && node scripts/deploy-firebase.mjs --hosting-only",
    "deploy:accounts": "npm ci --prefix functions && node scripts/deploy-firebase.mjs --accounts",
    "build:sites": "opennextjs-cloudflare build && node scripts/package-worker.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local",
    "preview": "opennextjs-cloudflare preview",
    "test:rules": "npm --prefix functions run build && npx --yes --package=firebase-tools@latest -- firebase emulators:exec --only auth,firestore,functions --project demo-dusaccom \"ACCOUNT_API_EMULATOR_URL=http://127.0.0.1:5001/demo-dusaccom/us-east4/accountApi node --import tsx --test tests/firebase/*.test.mjs\""
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.19.0",
    "lucide-react": "^1.31.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
