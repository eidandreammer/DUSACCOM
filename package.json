{
  "name": "dusaccom",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/optimize-images.mjs && next build --webpack",
    "build:sites": "opennextjs-cloudflare build && node scripts/package-worker.mjs",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local",
    "preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "@opennextjs/cloudflare": "1.20.13"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "postcss": "^8.5.0",
    "drizzle-kit": "^0.31.10",
    "@cloudflare/workers-types": "latest",
    "wrangler": "^4.148.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
