rules_version = '2';
// Data model:
// admins/{uid}: {enabled: bool}; trusted console/IAM operator manages roles.
// events/{id}: title/titleEs (1..160/0..160 chars), description/descriptionEs
// (1..2000/0..2000 chars), location (1..240), category (1..60 chars), startsAt UTC ISO
// string, timeZone IANA string (1..80), status confirmed, registration open/closed,
// createdBy (immutable auth UID), createdAt (immutable server timestamp).
// Confirmed event details are public so visitors can use the chamber calendar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }
    function bounded(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function validEvent(data) {
      return data.keys().hasAll(['title', 'titleEs', 'description', 'descriptionEs', 'location', 'category', 'startsAt', 'timeZone', 'status', 'registration', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['title', 'titleEs', 'description', 'descriptionEs', 'location', 'category', 'startsAt', 'timeZone', 'status', 'registration', 'createdBy', 'createdAt'])
        && bounded(data.title, 1, 160) && bounded(data.titleEs, 0, 160)
        && bounded(data.description, 1, 2000) && bounded(data.descriptionEs, 0, 2000)
        && bounded(data.location, 1, 240) && bounded(data.timeZone, 1, 80)
        && bounded(data.category, 1, 60) && data.category.matches('.*[^\\s].*')
        && data.status == 'confirmed' && data.registration in ['open', 'closed']
        && data.startsAt is string && data.startsAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$')
        && bounded(data.createdBy, 1, 128) && data.createdAt is timestamp;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /events/{id} {
      allow get: if resource.data.status == 'confirmed';
      allow list: if resource.data.status == 'confirmed' && request.query.limit <= 500;
      allow create: if admin() && validEvent(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if admin() && validEvent(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
