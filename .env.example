NEXT_PUBLIC_SITE_URL=https://dusaccom.web.app
# Optional canonical origin for build:firebase; defaults to https://dusaccnj.org.
FIREBASE_SITE_URL=
# The Firebase build selects firestore automatically; legacy server builds use api.
NEXT_PUBLIC_INQUIRY_BACKEND=api
NEXT_PUBLIC_GA_ID=
# Firebase web configuration (public values, never service-account credentials).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
